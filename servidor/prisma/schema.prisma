datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// Para timestamps se usa DateTime. Referencia:
// https://www.prisma.io/docs/orm/v7/core-concepts/supported-databases/sqlite#type-mappings
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime? @default(now())
}

model Class {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  section   String
  location  String
  schedule  String
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())
  stations  Station[]
}

model Station {
  id              Int             @id @default(autoincrement())
  code            String
  name            String
  location        String
  operatingSystem OperatingSystem
  ignored         Boolean?        @default(false)
  createdAt       DateTime?       @default(now())
  updatedAt       DateTime?       @default(now())
  classId         Int
  class           Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  reports         Report[]
  @@unique([classId, code])
}

// Para que se eliminen los reportes cuando se elimina una estación, se usa onDelete: Cascade
// https://www.prisma.io/docs/orm/v7/prisma-schema/data-model/relations/referential-actions#cascade
model Report {
  id             Int       @id @default(autoincrement())
  declaredStatus Status    @default(OK)
  agentVersion   String
  ipAddress      String
  cpuPercent     Int
  memoryPercent  Int
  createdAt      DateTime? @default(now())
  stationId      Int
  station        Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

// Para usar enums:
// https://www.prisma.io/docs/orm/v7/reference/prisma-schema-reference#default-value-for-an-enum
enum Status {
  OK
  INTERNET
  IA
}

enum OperatingSystem {
  WINDOWS
  MACOS
  LINUX
  CHROMEOS
}
